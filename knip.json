{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugins/harness-core/lib/bootstrap.mjs",
    "plugins/harness-core/lib/dungeon.mjs",
    "plugins/harness-core/lib/map.mjs",
    "plugins/harness-core/lib/claude-sync-cli.mjs",
    "plugins/harness-core/lib/new-repo-cli.mjs",
    "plugins/harness-core/lib/tower-cli.mjs",
    "plugins/harness-gates/lib/arch-scan.mjs",
    "plugins/harness-gates/lib/claims.mjs",
    "plugins/harness-gates/lib/clone-scan.mjs",
    "plugins/harness-gates/lib/dead-scan.mjs",
    "plugins/harness-gates/lib/dispatch.mjs",
    "plugins/harness-gates/lib/dupe-scan.mjs",
    "plugins/harness-gates/lib/fleet.mjs",
    "plugins/harness-gates/lib/incident-scan.mjs",
    "plugins/harness-gates/lib/log-cli.mjs",
    "plugins/harness-gates/lib/preflight.mjs",
    "plugins/harness-gates/lib/spec-gap-scan.mjs",
    "plugins/harness-gates/lib/standing.mjs",
    "scripts/*.mjs",
    "tests/**/*.test.mjs",
    "web/main.js",
    "rspack.config.mjs"
  ],
  "project": [
    "plugins/*/lib/*.mjs",
    "scripts/*.mjs",
    "tests/**/*.mjs",
    "web/**/*.js",
    "rspack.config.mjs"
  ],
  "ignore": [
    "plugins/harness-core/templates/**",
    "web/dist/**"
  ],
  "ignoreDependencies": [
    "@commitlint/config-conventional",
    "semantic-release"
  ]
}
