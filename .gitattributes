* text=auto eol=lf

# The bin/ launchers must stay executable and LF-terminated on every platform — a CRLF shebang
# fails with a confusing "bad interpreter" error. BOTH plugins: this named only harness-gates while
# claiming to cover "the bin/ launchers", so harness-core's four were protected by nothing but the
# repo-wide default.
plugins/*/bin/* text eol=lf

# ...except the Windows twins, which are the opposite case. A .cmd stored with bare LF misparses in
# some Windows shells, and the failure is the confusing kind — a line silently ignored rather than an
# error. These are generated by scripts/sync-launchers.mjs, which writes CRLF; this is what stops git
# from helpfully undoing that on the way in. The rule must stay BELOW the one above to win.
*.cmd text eol=crlf

# The run ledger is append-only. With a normal merge driver, two branches that each appended
# conflict on every concurrent write — which is how a metrics file gets deleted by the first
# person in a hurry. Union keeps both sides' lines.
*.jsonl merge=union
